# Every configuration key, with its default. Copy to .env to override (export them in your shell for host mode).
PLINTH_WORKSPACE_SLUG=northwind

# Postgres (compose publishes 55432 to avoid native services on 5432)
PLINTH_DB_HOST=127.0.0.1
PLINTH_DB_PORT=55432
PLINTH_DB_NAME=plinth
PLINTH_DB_USER=plinth
PLINTH_DB_PASSWORD=plinth
PLINTH_DB_POOL_MAX=10

# Object store (MinIO)
PLINTH_S3_ENDPOINT=http://127.0.0.1:59000
PLINTH_S3_REGION=us-east-1
PLINTH_S3_BUCKET=plinth-data
PLINTH_S3_FORCE_PATH_STYLE=true
PLINTH_S3_ACCESS_KEY=plinth
PLINTH_S3_SECRET_KEY=plinth-secret

# Process ports
PLINTH_API_PORT=8782
PLINTH_RT_PORT=8781
PLINTH_MCP_PORT=8790

# DuckDB. Autoinstall downloads the httpfs extension on first start; set false once it is installed offline.
PLINTH_DUCKDB_THREADS=1
PLINTH_DUCKDB_MEMORY_LIMIT=2GB
PLINTH_DUCKDB_AUTOINSTALL=true
# PLINTH_DUCKDB_EXTENSION_DIR=
PLINTH_DUCKDB_TEMP_DIR=.tmp/duckdb

# Queries
PLINTH_QUERY_DEFAULT_TIMEOUT_MS=5000
PLINTH_QUERY_MAX_TIMEOUT_MS=30000
PLINTH_QUERY_WATERMARK_WAIT_MS=10000

# Commit path
PLINTH_PREVIEW_TTL_S=300
PLINTH_COMMIT_LOCK_TIMEOUT_MS=2000

# Demo clock and data
PLINTH_DEMO_SEED=2026
PLINTH_DEMO_VIRTUAL_DATE=2026-11-20
PLINTH_DEMO_VIRTUAL_START=14:30:00
PLINTH_DEMO_CLOCK_RATE=6
PLINTH_HISTORY_DAYS=1
PLINTH_GEN_ORDERS_PER_DAY=80000

# Identity (L1 dev layer): subject=token pairs. Keycloak replaces this in L4.
PLINTH_DEV_TOKENS=user:ops-lead=dev-ops-lead,user:emea-lead=dev-emea-lead,user:finance-analyst=dev-finance-analyst,agent:claude-code=dev-agent-claude-code,service:replay-driver=dev-replay-driver,service:ingest=dev-ingest
# MCP stdio: token of the connecting principal (defaults to the dev token of --principal)
# PLINTH_MCP_TOKEN=dev-agent-claude-code

# Web dev server proxy targets and token (vite)
# PLINTH_API_URL=http://127.0.0.1:8782
# PLINTH_RT_URL=ws://127.0.0.1:8781
# VITE_PLINTH_TOKEN=dev-ops-lead
