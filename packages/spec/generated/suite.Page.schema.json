{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Page": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "plinth/v1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Page"
          ]
        },
        "metadata": {
          "type": "object",
          "required": [
            "slug",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/UUID"
            },
            "slug": {
              "$ref": "#/$defs/Slug"
            },
            "title": {
              "type": "string",
              "description": "a string at most 120 character(s) long",
              "title": "maxLength(120)",
              "minLength": 1,
              "maxLength": 120
            },
            "labels": {
              "type": "object",
              "required": [],
              "properties": {},
              "patternProperties": {
                "": {
                  "type": "string",
                  "description": "a string at most 253 character(s) long",
                  "title": "maxLength(253)",
                  "maxLength": 253
                }
              },
              "propertyNames": {
                "type": "string",
                "description": "a string matching the pattern ^[a-z][a-z0-9_.-]{0,62}$",
                "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
              }
            }
          },
          "additionalProperties": false
        },
        "spec": {
          "$ref": "#/$defs/PageSpec"
        }
      },
      "additionalProperties": false
    },
    "UUID": {
      "type": "string",
      "description": "a Universally Unique Identifier",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Slug": {
      "type": "string",
      "description": "a string matching the pattern ^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$",
      "title": "maxLength(63)",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$"
    },
    "PageSpec": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "system",
        "layout"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "module",
            "home",
            "profile",
            "custom",
            "personal"
          ]
        },
        "description": {
          "type": "string",
          "description": "User-authored text (untrusted), at most 280 chars",
          "title": "maxLength(280)",
          "maxLength": 280
        },
        "route": {
          "type": "string",
          "description": "a string matching the pattern ^\\/[a-z0-9/:_-]*$",
          "pattern": "^\\/[a-z0-9/:_-]*$"
        },
        "owner": {
          "$ref": "#/$defs/Subject"
        },
        "based_on": {
          "type": "string",
          "description": "a string matching the pattern ^page:[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
          "pattern": "^page:[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
        },
        "system": {
          "type": "boolean"
        },
        "nav": {
          "$ref": "#/$defs/PageNav"
        },
        "layout": {
          "type": "object",
          "required": [
            "columns",
            "items"
          ],
          "properties": {
            "columns": {
              "type": "number",
              "enum": [
                12
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PageItem"
              },
              "description": "an array of at most 40 item(s)",
              "title": "maxItems(40)",
              "maxItems": 40
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Subject": {
      "type": "string",
      "description": "A principal: user:<handle>, agent:<name>, service:<name>",
      "pattern": "^(user|agent|service):[a-z0-9][a-z0-9._-]*$"
    },
    "PageNav": {
      "type": "object",
      "required": [
        "section",
        "label",
        "icon",
        "order"
      ],
      "properties": {
        "section": {
          "type": "string",
          "enum": [
            "personal",
            "engage",
            "rewards",
            "operate",
            "insight",
            "admin"
          ]
        },
        "label": {
          "type": "string",
          "description": "a string at most 40 character(s) long",
          "title": "maxLength(40)",
          "maxLength": 40
        },
        "icon": {
          "$ref": "#/$defs/IconName"
        },
        "order": {
          "$ref": "#/$defs/Int",
          "description": "a number between 0 and 1000",
          "title": "between(0, 1000)",
          "minimum": 0,
          "maximum": 1000
        },
        "count": {
          "type": "string",
          "enum": [
            "notifications_unread",
            "messages_unread",
            "approvals_pending",
            "tasks_open",
            "cart_items",
            "content_reviews",
            "orders_attention"
          ]
        },
        "permission": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "IconName": {
      "type": "string",
      "enum": [
        "home",
        "inbox",
        "send",
        "archive",
        "star",
        "bell",
        "search",
        "command",
        "store",
        "cart",
        "bag",
        "tag",
        "gift",
        "coins",
        "wallet",
        "transfer",
        "trophy",
        "medal",
        "award",
        "crown",
        "flame",
        "bolt",
        "target",
        "megaphone",
        "percent",
        "calendar",
        "clock",
        "workflow",
        "play",
        "pause",
        "stop",
        "branch",
        "webhook",
        "document",
        "article",
        "announcement",
        "image",
        "users",
        "user",
        "group",
        "segment",
        "shield",
        "key",
        "lock",
        "chart",
        "board",
        "check",
        "check-circle",
        "x",
        "alert",
        "info",
        "task",
        "list",
        "settings",
        "sliders",
        "history",
        "audit",
        "attachment",
        "reply",
        "mention",
        "heart",
        "sparkle",
        "leaf",
        "globe",
        "truck",
        "box",
        "ticket",
        "coffee",
        "headphones",
        "laptop",
        "shirt",
        "book",
        "plant",
        "mountain",
        "sun",
        "moon",
        "plus",
        "minus",
        "edit",
        "trash",
        "copy",
        "link",
        "external",
        "filter",
        "sort",
        "more",
        "chevron-left",
        "chevron-right",
        "chevron-down",
        "chevron-up",
        "menu",
        "eye",
        "eye-off",
        "logout"
      ]
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "PageItem": {
      "type": "object",
      "required": [
        "item",
        "at"
      ],
      "properties": {
        "item": {
          "type": "string",
          "description": "a string matching the pattern ^(widget|panel):[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
          "pattern": "^(widget|panel):[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
        },
        "at": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/Int",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            "y": {
              "$ref": "#/$defs/Int",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            "w": {
              "$ref": "#/$defs/Int",
              "description": "a number greater than or equal to 1",
              "title": "greaterThanOrEqualTo(1)",
              "minimum": 1
            },
            "h": {
              "$ref": "#/$defs/Int",
              "description": "a number greater than or equal to 1",
              "title": "greaterThanOrEqualTo(1)",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "size": {
          "$ref": "#/$defs/WidgetSize"
        }
      },
      "additionalProperties": false
    },
    "WidgetSize": {
      "type": "string",
      "enum": [
        "s",
        "m",
        "l",
        "xl",
        "full"
      ]
    }
  },
  "$ref": "#/$defs/Page"
}
