{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "NodeCommitInput": {
      "type": "object",
      "required": [
        "preview_token",
        "idempotency_key"
      ],
      "properties": {
        "preview_token": {
          "type": "string",
          "description": "The preview_token returned by node.preview (single use, valid 300 s).",
          "pattern": "^pvt_[A-Za-z0-9_-]{43}$"
        },
        "idempotency_key": {
          "type": "string",
          "description": "a string matching the pattern ^[A-Za-z0-9:._-]{8,128}$",
          "pattern": "^[A-Za-z0-9:._-]{8,128}$"
        },
        "reason": {
          "type": "string",
          "description": "a string at most 280 character(s) long",
          "title": "maxLength(280)",
          "maxLength": 280
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/NodeCommitInput"
}
