{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Preference": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "plinth/v1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Preference"
          ]
        },
        "metadata": {
          "type": "object",
          "required": [
            "slug",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/UUID"
            },
            "slug": {
              "$ref": "#/$defs/Slug"
            },
            "title": {
              "type": "string",
              "description": "a string at most 120 character(s) long",
              "title": "maxLength(120)",
              "minLength": 1,
              "maxLength": 120
            },
            "labels": {
              "type": "object",
              "required": [],
              "properties": {},
              "patternProperties": {
                "": {
                  "type": "string",
                  "description": "a string at most 253 character(s) long",
                  "title": "maxLength(253)",
                  "maxLength": 253
                }
              },
              "propertyNames": {
                "type": "string",
                "description": "a string matching the pattern ^[a-z][a-z0-9_.-]{0,62}$",
                "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
              }
            }
          },
          "additionalProperties": false
        },
        "spec": {
          "$ref": "#/$defs/PreferenceSpec"
        }
      },
      "additionalProperties": false
    },
    "UUID": {
      "type": "string",
      "description": "a Universally Unique Identifier",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Slug": {
      "type": "string",
      "description": "a string matching the pattern ^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$",
      "title": "maxLength(63)",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$"
    },
    "PreferenceSpec": {
      "type": "object",
      "required": [
        "owner",
        "notifications",
        "digest",
        "muted_threads",
        "ui"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/Subject"
        },
        "notifications": {
          "type": "object",
          "required": [
            "mention",
            "message",
            "approval_request",
            "approval_decision",
            "points_awarded",
            "points_expiring",
            "badge_earned",
            "tier_changed",
            "order_status",
            "automation_alert",
            "content_review",
            "content_published",
            "task_assigned",
            "promotion_started",
            "system"
          ],
          "properties": {
            "mention": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "message": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "approval_request": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "approval_decision": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "points_awarded": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "points_expiring": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "badge_earned": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "tier_changed": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "order_status": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "automation_alert": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "content_review": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "content_published": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "task_assigned": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "promotion_started": {
              "$ref": "#/$defs/ChannelPrefs"
            },
            "system": {
              "$ref": "#/$defs/ChannelPrefs"
            }
          },
          "additionalProperties": false
        },
        "digest": {
          "$ref": "#/$defs/DigestPrefs"
        },
        "quiet_hours": {
          "type": "object",
          "required": [
            "start_hour",
            "end_hour"
          ],
          "properties": {
            "start_hour": {
              "$ref": "#/$defs/Int",
              "description": "a number between 0 and 23",
              "title": "between(0, 23)",
              "minimum": 0,
              "maximum": 23
            },
            "end_hour": {
              "$ref": "#/$defs/Int",
              "description": "a number between 0 and 23",
              "title": "between(0, 23)",
              "minimum": 0,
              "maximum": 23
            }
          },
          "additionalProperties": false
        },
        "muted_threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UUID"
          },
          "description": "an array of at most 200 item(s)",
          "title": "maxItems(200)",
          "maxItems": 200
        },
        "ui": {
          "$ref": "#/$defs/UiPrefs"
        }
      },
      "additionalProperties": false
    },
    "Subject": {
      "type": "string",
      "description": "A principal: user:<handle>, agent:<name>, service:<name>",
      "pattern": "^(user|agent|service):[a-z0-9][a-z0-9._-]*$"
    },
    "ChannelPrefs": {
      "type": "object",
      "required": [
        "in_app",
        "email",
        "digest"
      ],
      "properties": {
        "in_app": {
          "type": "boolean"
        },
        "email": {
          "type": "boolean"
        },
        "digest": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "DigestPrefs": {
      "type": "object",
      "required": [
        "frequency",
        "hour_utc"
      ],
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "off",
            "daily",
            "weekly"
          ]
        },
        "hour_utc": {
          "$ref": "#/$defs/Int",
          "description": "a number between 0 and 23",
          "title": "between(0, 23)",
          "minimum": 0,
          "maximum": 23
        },
        "weekday": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 7",
          "title": "between(1, 7)",
          "minimum": 1,
          "maximum": 7
        }
      },
      "additionalProperties": false
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "UiPrefs": {
      "type": "object",
      "required": [
        "theme",
        "density",
        "reduced_motion"
      ],
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "home_widgets": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a string matching the pattern ^[a-z][a-z0-9-]{1,40}$",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "description": "an array of at most 16 item(s)",
          "title": "maxItems(16)",
          "maxItems": 16
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Preference"
}
