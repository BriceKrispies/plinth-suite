{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "NodeSearchInput": {
      "type": "object",
      "required": [],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Dashboard",
            "Panel",
            "Query",
            "Source",
            "Parameter",
            "Rule",
            "Action",
            "Form",
            "Workflow",
            "Grant",
            "Metric",
            "Template",
            "Export",
            "Annotation",
            "Comment",
            "Product",
            "Category",
            "Badge",
            "Promotion",
            "Automation",
            "Content",
            "Segment",
            "Group",
            "Role",
            "Preference",
            "Program",
            "Widget",
            "Page"
          ]
        },
        "text": {
          "type": "string",
          "description": "a string at most 200 character(s) long",
          "title": "maxLength(200)",
          "maxLength": 200
        },
        "labels": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {
            "type": "string",
            "description": "a string at most 64 character(s) long",
            "title": "maxLength(64)",
            "maxLength": 64
          }
        },
        "limit": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 100",
          "title": "between(1, 100)",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "$ref": "#/$defs/NodeSearchInput"
}
