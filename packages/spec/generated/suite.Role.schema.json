{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Role": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "plinth/v1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Role"
          ]
        },
        "metadata": {
          "type": "object",
          "required": [
            "slug",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/UUID"
            },
            "slug": {
              "$ref": "#/$defs/Slug"
            },
            "title": {
              "type": "string",
              "description": "a string at most 120 character(s) long",
              "title": "maxLength(120)",
              "minLength": 1,
              "maxLength": 120
            },
            "labels": {
              "type": "object",
              "required": [],
              "properties": {},
              "patternProperties": {
                "": {
                  "type": "string",
                  "description": "a string at most 253 character(s) long",
                  "title": "maxLength(253)",
                  "maxLength": 253
                }
              },
              "propertyNames": {
                "type": "string",
                "description": "a string matching the pattern ^[a-z][a-z0-9_.-]{0,62}$",
                "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
              }
            }
          },
          "additionalProperties": false
        },
        "spec": {
          "$ref": "#/$defs/RoleSpec"
        }
      },
      "additionalProperties": false
    },
    "UUID": {
      "type": "string",
      "description": "a Universally Unique Identifier",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Slug": {
      "type": "string",
      "description": "a string matching the pattern ^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$",
      "title": "maxLength(63)",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*(?:[-.][a-z0-9_]+)*$"
    },
    "RoleSpec": {
      "type": "object",
      "required": [
        "description",
        "members",
        "system"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "User-authored text (untrusted), at most 500 chars",
          "title": "maxLength(500)",
          "maxLength": 500
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoleMember"
          },
          "description": "an array of at most 1000 item(s)",
          "title": "maxItems(1000)",
          "maxItems": 1000
        },
        "system": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RoleMember": {
      "type": "object",
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "scope": {
          "type": "object",
          "required": [
            "region"
          ],
          "properties": {
            "region": {
              "$ref": "#/$defs/Region"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Subject": {
      "type": "string",
      "description": "A principal: user:<handle>, agent:<name>, service:<name>",
      "pattern": "^(user|agent|service):[a-z0-9][a-z0-9._-]*$"
    },
    "Region": {
      "type": "string",
      "enum": [
        "NA",
        "EMEA",
        "APAC",
        "LATAM",
        "ANZ"
      ]
    }
  },
  "$ref": "#/$defs/Role"
}
