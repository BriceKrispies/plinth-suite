{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "SourceListInput": {
      "type": "object",
      "required": [],
      "properties": {
        "domain": {
          "type": "string",
          "description": "a string at most 64 character(s) long",
          "title": "maxLength(64)",
          "maxLength": 64
        },
        "source": {
          "$ref": "#/$defs/NodeRef"
        },
        "limit": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 200",
          "title": "between(1, 200)",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "NodeRef": {
      "type": "string",
      "description": "A node: plinth://<ws>/<Kind>/<uuid>, kind:slug (e.g. dashboard:ops-board), or a bare slug when unambiguous.",
      "title": "maxLength(200)",
      "minLength": 2,
      "maxLength": 200
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "$ref": "#/$defs/SourceListInput"
}
