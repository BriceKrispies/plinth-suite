{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "ActionListInput": {
      "type": "object",
      "required": [],
      "properties": {
        "module": {
          "type": "string",
          "description": "Filter by module, e.g. points, store, messages",
          "title": "maxLength(32)",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "One action, with its schemas",
          "title": "maxLength(64)",
          "maxLength": 64
        },
        "include_schemas": {
          "type": "boolean",
          "description": "Include input and output JSON Schema (default true when name is given)"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/ActionListInput"
}
