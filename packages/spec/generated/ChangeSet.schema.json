{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "ChangeSet": {
      "type": "object",
      "required": [
        "changes"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeChange"
          },
          "description": "an array of at most 16 item(s)",
          "title": "maxItems(16)",
          "minItems": 1,
          "maxItems": 16
        }
      },
      "additionalProperties": false
    },
    "NodeChange": {
      "type": "object",
      "required": [
        "target",
        "base_revision",
        "ops"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/Uri"
        },
        "base_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeOp"
          },
          "description": "an array of at most 64 item(s)",
          "title": "maxItems(64)",
          "minItems": 1,
          "maxItems": 64
        }
      },
      "additionalProperties": false
    },
    "Uri": {
      "type": "string",
      "description": "a string matching the pattern ^plinth:\\/\\/[a-z0-9-]+\\/(Dashboard|Panel|Query|Source|Parameter|Rule|Action|Form|Workflow|Grant|Metric|Template|Export|Annotation|Comment|Product|Category|Badge|Promotion|Automation|Content|Segment|Group|Role|Preference|Program|Widget|Page)\\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "pattern": "^plinth:\\/\\/[a-z0-9-]+\\/(Dashboard|Panel|Query|Source|Parameter|Rule|Action|Form|Workflow|Grant|Metric|Template|Export|Annotation|Comment|Product|Category|Badge|Promotion|Automation|Content|Segment|Group|Role|Preference|Program|Widget|Page)\\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Revision": {
      "type": "integer",
      "description": "a number greater than or equal to 1",
      "title": "greaterThanOrEqualTo(1)",
      "minimum": 1
    },
    "ChangeOp": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "op",
            "kind",
            "slug",
            "body"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "create"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "Dashboard",
                "Panel",
                "Query",
                "Source",
                "Parameter",
                "Rule",
                "Action",
                "Form",
                "Workflow",
                "Grant",
                "Metric",
                "Template",
                "Export",
                "Annotation",
                "Comment",
                "Product",
                "Category",
                "Badge",
                "Promotion",
                "Automation",
                "Content",
                "Segment",
                "Group",
                "Role",
                "Preference",
                "Program",
                "Widget",
                "Page"
              ]
            },
            "slug": {
              "type": "string"
            },
            "body": {
              "$id": "/schemas/unknown",
              "title": "unknown"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "set"
              ]
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            },
            "value": {
              "$id": "/schemas/unknown",
              "title": "unknown"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "remove"
              ]
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "delete"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "JsonPointer": {
      "type": "string",
      "description": "a string matching the pattern ^(\\/([^/~]|~[01])*)*$",
      "pattern": "^(\\/([^/~]|~[01])*)*$"
    }
  },
  "$ref": "#/$defs/ChangeSet"
}
